{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/384363367-dot/legal-os/schemas/legalos-manifest.schema.json",
  "title": "Legal OS public manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "product",
    "release",
    "profile",
    "authority",
    "profiles",
    "execution_modes",
    "skills",
    "routes",
    "invocation_policy",
    "template_runtime",
    "quality_gates"
  ],
  "properties": {
    "$schema": {
      "const": "./schemas/legalos-manifest.schema.json"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "public_version",
        "release_status",
        "version_namespace"
      ],
      "properties": {
        "name": {
          "const": "Legal OS"
        },
        "public_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "release_status": {
          "enum": [
            "released",
            "superseded"
          ]
        },
        "version_namespace": {
          "const": "public-semver"
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_id", "version"],
      "properties": {
        "release_id": {
          "type": "string",
          "pattern": "^legalos-v[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "payload"],
      "properties": {
        "profile_id": {"const": "public-generic"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["skill_count", "file_count", "tree_sha256"],
          "properties": {
            "skill_count": {"type": "integer", "minimum": 1},
            "file_count": {"type": "integer", "minimum": 1},
            "tree_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }
        }
      }
    },
    "authority": {
      "type": "object"
    },
    "profiles": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object"
      }
    },
    "execution_modes": {
      "type": "object",
      "required": [
        "route-only",
        "route-and-run"
      ],
      "additionalProperties": false,
      "properties": {
        "route-only": {
          "type": "string"
        },
        "route-and-run": {
          "type": "string"
        }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "routes": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object"
      }
    },
    "invocation_policy": {
      "type": "object"
    },
    "template_runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog",
        "resolver",
        "content_model",
        "private_overlay",
        "no_template_status"
      ],
      "properties": {
        "catalog": {
          "type": "string"
        },
        "resolver": {
          "type": "string"
        },
        "content_model": {
          "const": "fixed-shell-flexible-body"
        },
        "private_overlay": {
          "const": "supported-not-distributed"
        },
        "no_template_status": {
          "const": "TEMPLATE_REQUIRED"
        }
      }
    },
    "quality_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    }
  }
}
