{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "legal-os://schemas/review-signoff.schema.json",
  "title": "Legal OS Human Review Sign-off",
  "type": "object",
  "required": ["schema_version", "matter_task_id", "artifact_path", "artifact_sha256", "risk_level", "reviewer", "reviewed_at", "status", "permitted_use", "checks"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "matter_task_id": {"type": "string", "minLength": 3},
    "artifact_path": {"type": "string", "minLength": 3},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "risk_level": {"enum": ["R0", "R1", "R2", "R3"]},
    "reviewer": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "minLength": 10},
    "status": {"enum": ["approved", "rejected", "pending"]},
    "permitted_use": {"enum": ["internal-draft", "internal-final", "external-final", "filing", "publishing"]},
    "rebind_candidate": {
      "type": "object",
      "required": ["schema_version", "classification", "old_artifact_path", "old_artifact_sha256", "new_artifact_path", "new_artifact_sha256", "created_at", "changed_parts", "diff_summary", "requires_affected_review"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "classification": {"enum": ["identical", "format-only", "content-change", "manual-review-required"]},
        "old_artifact_path": {"type": "string", "minLength": 1},
        "old_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "new_artifact_path": {"type": "string", "minLength": 1},
        "new_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "created_at": {"type": "string", "minLength": 10},
        "changed_parts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["part", "old_sha256", "new_sha256"],
            "properties": {
              "part": {"type": "string", "minLength": 1},
              "old_sha256": {"type": ["string", "null"]},
              "new_sha256": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          }
        },
        "diff_summary": {"type": "string", "minLength": 1},
        "redline_gate_status": {"enum": ["PASS", "FAIL", "not-applicable"]},
        "scope": {"type": "string", "minLength": 1},
        "semantic_review": {"type": "string", "minLength": 1},
        "reviewed_by": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "minLength": 10},
        "requires_affected_review": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"classification": {"enum": ["content-change", "manual-review-required"]}}, "required": ["classification"]},
          "then": {"required": ["scope", "semantic_review", "reviewed_by", "reviewed_at"]}
        }
      ],
      "additionalProperties": false
    },
    "rebind_record": {
      "type": "object",
      "required": ["schema_version", "classification", "old_artifact_path", "old_artifact_sha256", "old_signoff_path", "old_signoff_sha256", "new_artifact_path", "new_artifact_sha256", "created_at", "changed_parts", "visual_property_changes", "diff_summary", "requires_affected_review"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "classification": {"enum": ["identical", "format-only"]},
        "old_artifact_path": {"type": "string", "minLength": 1},
        "old_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "old_signoff_path": {"type": "string", "minLength": 1},
        "old_signoff_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "new_artifact_path": {"type": "string", "minLength": 1},
        "new_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "created_at": {"type": "string", "minLength": 10},
        "changed_parts": {"type": "array", "items": {"type": "object", "required": ["part", "old_sha256", "new_sha256"], "properties": {"part": {"type": "string", "minLength": 1}, "old_sha256": {"type": "string", "minLength": 1}, "new_sha256": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
        "visual_property_changes": {"type": "array", "items": {"type": "object", "required": ["node_property", "old_value", "new_value"], "properties": {"node_property": {"type": "string", "minLength": 1}, "old_value": {"type": "string"}, "new_value": {"type": "string"}}, "additionalProperties": false}},
        "diff_summary": {"type": "string", "minLength": 1},
        "requires_affected_review": {"const": false}
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "object",
      "required": ["facts", "authority", "strategy", "format", "privacy"],
      "properties": {
        "facts": {"const": true},
        "authority": {"const": true},
        "strategy": {"const": true},
        "format": {"const": true},
        "privacy": {"const": true}
      },
      "additionalProperties": false
    },
    "contract_protection_review": {
      "type": "object",
      "required": ["review_scope"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reviewer": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "minLength": 10},
        "review_scope": {"type": "string", "minLength": 1},
        "review_round": {"enum": ["single", "subsequent"]},
        "review_path": {"enum": ["full", "light"]},
        "reviewed_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reviewed_diff_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "semantic_review": {"type": "string", "minLength": 1},
        "status": {"const": "approved"},
        "all_supported_core_risks_mapped": {"const": true},
        "core_risks_status": {"enum": ["identified", "none"]},
        "no_core_risks_rationale": {"type": "string", "minLength": 1},
        "risk_mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["risk_id", "core_risk", "intended_protection", "final_clause_refs", "final_clause_excerpt_or_absence_reason", "cross_references_complete", "outcome", "review_judgment"],
            "properties": {
              "risk_id": {"type": "string", "minLength": 1},
              "core_risk": {"type": "string", "minLength": 1},
              "intended_protection": {"type": "string", "minLength": 1},
              "first_pass_agreed_protection": {"type": "string", "minLength": 1},
              "final_clause_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "final_clause_excerpt_or_absence_reason": {"type": "string", "minLength": 1},
              "cross_references_complete": {"const": true},
              "outcome": {"enum": ["preserved", "approved_compromise", "missing", "unresolved", "weakened"]},
              "review_judgment": {"type": "string", "minLength": 1},
              "compromise": {
                "type": "object",
                "required": ["approval_source", "approval_ref", "approved_by", "approved_at", "proportionality_reason", "retained_protection_or_rationale"],
                "properties": {
                  "approval_source": {"enum": ["current-user-instruction", "matter-document", "approved-negotiation-policy"]},
                  "approval_ref": {"type": "string", "minLength": 1},
                  "approved_by": {"type": "string", "minLength": 1},
                  "approved_at": {"type": "string", "minLength": 10},
                  "proportionality_reason": {"type": "string", "minLength": 1},
                  "retained_protection_or_rationale": {"type": "string", "minLength": 1}
                },
                "additionalProperties": false
              }
            },
            "allOf": [
              {
                "if": {"properties": {"outcome": {"const": "approved_compromise"}}, "required": ["outcome"]},
                "then": {"required": ["compromise"]}
              },
              {
                "if": {"properties": {"outcome": {"const": "preserved"}}, "required": ["outcome"]},
                "then": {"properties": {"final_clause_refs": {"minItems": 1}}}
              }
            ],
            "additionalProperties": false
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"review_round": {"const": "single"}}, "required": ["review_round"]},
          "then": {},
          "else": {"properties": {"risk_mappings": {"items": {"required": ["first_pass_agreed_protection"]}}}}
        },
        {
          "if": {"properties": {"review_path": {"const": "light"}}, "required": ["review_path"]},
          "then": {
            "required": ["core_risks_status", "no_core_risks_rationale"],
            "properties": {
              "core_risks_status": {"const": "none"},
              "risk_mappings": {"maxItems": 0}
            }
          },
          "else": {
            "required": ["schema_version", "artifact_sha256", "reviewer", "reviewed_at", "status", "all_supported_core_risks_mapped", "risk_mappings"]
          }
        },
        {
          "if": {"properties": {"core_risks_status": {"const": "identified"}}, "required": ["core_risks_status"]},
          "then": {"properties": {"risk_mappings": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"core_risks_status": {"const": "none"}}, "required": ["core_risks_status"]},
          "then": {"required": ["no_core_risks_rationale"], "properties": {"risk_mappings": {"maxItems": 0}}}
        }
      ],
      "additionalProperties": false
    },
    "amount_review": {
      "type": "object",
        "required": ["schema_version", "artifact_sha256", "scope", "status", "artifact_amounts_reconciled", "conclusion_review", "chains"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reviewer": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "minLength": 10},
        "scope": {"type": "string", "minLength": 1},
        "status": {"enum": ["verified", "unable-to-verify", "failed"]},
        "artifact_amounts_reconciled": {"type": "boolean"},
        "conclusion_review": {"type": "string", "minLength": 1},
        "review_note": {"type": "string", "minLength": 1},
        "chains": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["chain_id", "currency", "rounding", "original_amount", "initially_included_factor_ids", "adjustments", "payments", "offsets", "reported_totals"],
            "properties": {
              "chain_id": {"type": "string", "minLength": 1},
              "currency": {"type": "string", "minLength": 1},
              "rounding": {
                "type": "object",
                "required": ["decimal_places", "mode"],
                "properties": {
                  "decimal_places": {"type": "integer", "minimum": 0, "maximum": 6},
                  "mode": {"enum": ["half-up", "half-even", "down", "up"]}
                },
                "additionalProperties": false
              },
              "original_amount": {
                "type": "object",
                "required": ["value", "source_ref", "evidence_status"],
                "properties": {
                  "value": {"type": ["number", "null"]},
                  "source_ref": {"type": "string"},
                  "evidence_status": {"enum": ["confirmed", "missing", "conflicted", "unverified"]}
                },
                "additionalProperties": false
              },
              "initially_included_factor_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "adjustments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["adjustment_id", "factor_id", "source_ref", "nature", "evidence_status", "basis_from", "basis_amount", "kind", "deduction_amount", "resulting_amount"],
                  "properties": {
                    "adjustment_id": {"type": "string", "minLength": 1, "not": {"const": "original_amount"}},
                    "factor_id": {"type": "string", "minLength": 1},
                    "source_ref": {"type": "string"},
                    "nature": {"type": "string"},
                    "evidence_status": {"enum": ["confirmed", "missing", "conflicted", "unverified"]},
                    "basis_from": {"type": "string", "minLength": 1},
                    "basis_amount": {"type": ["number", "null"]},
                    "kind": {"enum": ["percentage", "fixed"]},
                    "rate": {"type": ["number", "null"], "minimum": 0},
                    "fixed_amount": {"type": ["number", "null"], "minimum": 0},
                    "deduction_amount": {"type": ["number", "null"], "minimum": 0},
                    "resulting_amount": {"type": ["number", "null"]}
                  },
                  "allOf": [
                    {
                      "if": {"properties": {"kind": {"const": "percentage"}}, "required": ["kind"]},
                      "then": {"required": ["rate"], "not": {"required": ["fixed_amount"]}}
                    },
                    {
                      "if": {"properties": {"kind": {"const": "fixed"}}, "required": ["kind"]},
                      "then": {"required": ["fixed_amount"], "not": {"required": ["rate"]}}
                    }
                  ],
                  "additionalProperties": false
                }
              },
              "payments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["record_id", "factor_id", "source_ref", "evidence_status", "amount"],
                  "properties": {
                    "record_id": {"type": "string", "minLength": 1},
                    "factor_id": {"type": "string", "minLength": 1},
                    "source_ref": {"type": "string"},
                    "evidence_status": {"enum": ["confirmed", "missing", "conflicted", "unverified"]},
                    "amount": {"type": ["number", "null"], "minimum": 0}
                  },
                  "additionalProperties": false
                }
              },
              "offsets": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["offset_id", "factor_id", "source_ref", "nature", "evidence_status", "amount"],
                  "properties": {
                    "offset_id": {"type": "string", "minLength": 1},
                    "factor_id": {"type": "string", "minLength": 1},
                    "source_ref": {"type": "string"},
                    "nature": {"type": "string"},
                    "evidence_status": {"enum": ["confirmed", "missing", "conflicted", "unverified"]},
                    "amount": {"type": ["number", "null"], "minimum": 0}
                  },
                  "additionalProperties": false
                }
              },
              "reported_totals": {
                "type": "object",
                "required": ["gross", "adjustments_total", "adjusted_gross", "paid_total", "offsets_total", "net_total"],
                "properties": {
                  "gross": {"type": ["number", "null"]},
                  "adjustments_total": {"type": ["number", "null"]},
                  "adjusted_gross": {"type": ["number", "null"]},
                  "paid_total": {"type": ["number", "null"]},
                  "offsets_total": {"type": ["number", "null"]},
                  "net_total": {"type": ["number", "null"]}
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "verified"}}, "required": ["status"]},
          "then": {
            "required": ["reviewer", "reviewed_at"],
            "properties": {"artifact_amounts_reconciled": {"const": true}}
          }
        }
      ],
      "additionalProperties": false
    },
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
